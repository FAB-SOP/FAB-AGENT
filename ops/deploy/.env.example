# Local container deployment. Copy to ops/deploy/.env to customize.
DEPLOY_WEB_PORT=8088
# No paid API calls with these defaults.
DEPLOY_LLM=rule
DEPLOY_EMBEDDER=hash
DEPLOY_MODEL=gpt-4o-mini
DEPLOY_FALLBACK_MODEL=gpt-4o-mini
DEPLOY_EMBED_MODEL=text-embedding-3-small
DEPLOY_OPENAI_API_KEY=

# Enable only for an isolated demonstration with seeded accounts.
DEPLOY_DEMO_PERSONA_SWITCH=false
