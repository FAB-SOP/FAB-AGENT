{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "incidentId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "jobId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "threadId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "이 이벤트를 낸 작업 시도 — job-message의 attempt와 같다. backend는 이것으로 이전 시도의 늦은 이벤트(성공 · 실패 모두)를 막는다(metrics.attempt는 선택 칸이라 쓰지 않는다)"
    },
    "type": {
      "type": "string",
      "enum": [
        "JOB_STARTED",
        "ANALYSIS_PROGRESS",
        "RESULT_READY",
        "APPROVAL_REQUIRED",
        "WAITING_REPLY",
        "RETRY_SCHEDULED",
        "JOB_FAILED",
        "REPORT_DRAFT_READY",
        "SUMMARY_READY"
      ]
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "description": "도구/분석 종류별 하위 schema는 tool-catalog.json의 계약을 적용한다."
    },
    "metrics": {
      "type": "object",
      "description": "선택. 작업을 끝내거나 멈추는 이벤트(RESULT_READY · REPORT_DRAFT_READY · SUMMARY_READY · APPROVAL_REQUIRED · WAITING_REPLY · RETRY_SCHEDULED · JOB_FAILED)에만 싣는 이번 시도의 trace 요약. backend는 job.metrics에 저장한다. 프롬프트 · 응답 원문 · 키는 넣지 않는다.",
      "properties": {
        "traceId": {"type": "string"},
        "attempt": {"type": "integer", "minimum": 1},
        "modelCalls": {"type": "integer", "minimum": 0},
        "fallbackCalls": {"type": "integer", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "apiModels": {"type": "array", "items": {"type": "string"}},
        "toolCalls": {"type": "integer", "minimum": 0},
        "toolErrors": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "guardRejects": {"type": "integer", "minimum": 0},
        "ms": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "incidentId",
    "jobId",
    "threadId",
    "sequence",
    "attempt",
    "type",
    "at",
    "traceId",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "JOB_STARTED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "startedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "startedAt"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ANALYSIS_PROGRESS"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "stepCode": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "progressRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "stepCode",
              "message",
              "progressRatio"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RESULT_READY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "result": {
                "$ref": "../public-openapi.json#/components/schemas/AnalysisResult"
              },
              "workSuggestions": {
                "type": "array",
                "maxItems": 5,
                "description": "선택적 업무 제안. 채택·승인·발송·수행 기록이 아니다.",
                "items": {
                  "type": "object",
                  "properties": {
                    "operationCode": {
                      "type": "string",
                      "enum": [
                        "REVIEW_SENSOR_DATA",
                        "REVIEW_PROCESS_HISTORY",
                        "COMPARE_METROLOGY",
                        "CHANGE_SETPOINT",
                        "CHANGE_RECIPE",
                        "REPLACE_COMPONENT",
                        "RESTART_EQUIPMENT",
                        "REVIEW_REQUIRED",
                        "EQUIPMENT_INSPECTION",
                        "FACILITY_INSPECTION",
                        "UPSTREAM_CHECK"
                      ]
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "evidenceIds": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "operationCode",
                    "title",
                    "reason",
                    "evidenceIds"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "result"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "APPROVAL_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "approvalId": {
                "type": "string"
              },
              "approvalVersion": {
                "type": "integer"
              },
              "interruptId": {
                "type": "string"
              }
            },
            "required": [
              "approvalId",
              "approvalVersion",
              "interruptId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "WAITING_REPLY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "requestId": {
                "type": "string"
              },
              "interruptId": {
                "type": "string"
              }
            },
            "required": [
              "requestId",
              "interruptId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "RETRY_SCHEDULED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "nextAttempt": {
                "type": "integer",
                "minimum": 2,
                "maximum": 3
              },
              "nextRetryAt": {
                "type": "string",
                "format": "date-time"
              },
              "errorCode": {
                "type": "string"
              }
            },
            "required": [
              "nextAttempt",
              "nextRetryAt",
              "errorCode"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "JOB_FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "errorCode": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "dlqRef": {
                "type": "string"
              }
            },
            "required": [
              "errorCode",
              "message",
              "dlqRef"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "REPORT_DRAFT_READY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "report": {
                "$ref": "../public-openapi.json#/components/schemas/Report"
              }
            },
            "required": [
              "report"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUMMARY_READY"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "description": "확정 보고서 요약(SUMMARY 작업) — backend가 Job의 input.summaryRef · 지금 확정 스냅샷 · 현재 요약 작업과 대조한 뒤 반영한다",
            "properties": {
              "reportId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "snapshotRef": {
                "type": "string"
              },
              "summary": {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "minItems": 1,
                    "maxItems": 2
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
                    }
                  },
                  "generatedBy": {
                    "type": "string",
                    "enum": [
                      "model",
                      "rule"
                    ]
                  }
                },
                "required": [
                  "lines",
                  "evidenceIds",
                  "generatedBy"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "reportId",
              "snapshotRef",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
