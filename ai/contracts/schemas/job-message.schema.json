{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "jobId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "incidentId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "threadId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "kind": {
      "type": "string",
      "enum": [
        "BASIC",
        "DEEP",
        "RESUME",
        "REPORT",
        "SUMMARY"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "contextRef": {
      "type": "string"
    },
    "resume": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "APPROVAL_DECIDED",
                "REPLY_RECEIVED"
              ]
            },
            "refId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "interruptId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "parentJobId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            }
          },
          "required": [
            "reason",
            "refId",
            "interruptId",
            "parentJobId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input": {
      "type": "object",
      "description": "선택. 작업 종류별 입력 — 이 계약에 정의한 필드만 싣는다(DB의 job.input을 통째로 내보내지 않는다, 내부 제어값 · 비밀값 없음). SUMMARY는 summaryRef 필수",
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "BASIC",
            "QUESTION",
            "FOLLOWUP",
            "REQUEST",
            "REPORT"
          ],
          "description": "실행 목적 — kind BASIC은 BASIC, REPORT는 REPORT, DEEP은 QUESTION · FOLLOWUP · REQUEST. SUMMARY는 kind와 summaryRef로 구분하고 purpose를 쓰지 않는다. 전환 기간에 맥락 trigger · 질문 칸 방식과 함께 오면 purpose가 우선이고, 모순이면 Agent가 INVALID_INPUT으로 실패시킨다"
        },
        "followup": {
          "type": "object",
          "description": "추가 분석(FOLLOWUP) — 작업자가 고른 조사 결과. backend가 원본을 조회해 만든 접수 시점 스냅샷(프론트가 보낸 내용을 그대로 쓰지 않는다)",
          "properties": {
            "analysisRequestId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "question": {
              "type": "string",
              "maxLength": 2000
            },
            "selectedInputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "sourceRef": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "REPLY",
                          "ACTION",
                          "REQUEST_DECISION"
                        ]
                      },
                      "id": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "type",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "evidenceId": {
                    "type": "string",
                    "description": "E-REQ-{requestId}(회신 · 거절 사유) · E-ACT-{actionId}(내 작업 결과) — 결과가 이 ID를 인용하면 실제 인용"
                  },
                  "content": {
                    "type": "string"
                  },
                  "authorUserId": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "requestId": {
                    "type": "string"
                  },
                  "taskId": {
                    "type": "string"
                  },
                  "evidenceIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "sourceRef",
                  "evidenceId",
                  "content",
                  "authorUserId",
                  "createdAt"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "analysisRequestId",
            "selectedInputs"
          ],
          "additionalProperties": false
        },
        "request": {
          "type": "object",
          "description": "요청서 생성(REQUEST) — 사람이 정한 대상 공정 · 원인. 재생성 · 대체는 이번 MVP에서 제외(승인 거절 뒤 새 요청서)",
          "properties": {
            "causeIds": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "targetProcessCode": {
              "type": "string",
              "enum": [
                "CVD",
                "ETCH",
                "CMP"
              ]
            }
          },
          "additionalProperties": false
        },
        "replyFlow": {
          "type": "string",
          "enum": [
            "WAIT",
            "MANUAL"
          ],
          "description": "회신 흐름 판 — backend가 작업에 저장해 준다. WAIT: 승인 → 요청 등록 → 회신 대기(기존). MANUAL: 요청을 보낸 뒤 그래프를 끝내고, 회신은 사람이 골라 추가 분석으로 반영. Agent는 thread를 시작할 때 고정하고, 기존 thread와 RESUME은 처음 값을 유지한다"
        },
        "summaryRef": {
          "type": "object",
          "description": "요약할 확정 보고서 — 서버가 확정 스냅샷에서 만든다(현재 조사 데이터로 대체하지 않는다)",
          "properties": {
            "reportId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "reportVersion": {
              "type": "integer",
              "minimum": 1
            },
            "contentRevision": {
              "type": "integer",
              "minimum": 0
            },
            "snapshotRef": {
              "type": "string",
              "description": "확정 스냅샷 — snapshot://reports/{reportId}/v{version}/r{contentRevision}"
            }
          },
          "required": [
            "reportId",
            "reportVersion",
            "contentRevision",
            "snapshotRef"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "jobId",
    "incidentId",
    "threadId",
    "kind",
    "attempt",
    "contextRef",
    "resume",
    "createdAt",
    "traceId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RESUME"
          }
        }
      },
      "then": {
        "properties": {
          "resume": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "APPROVAL_DECIDED",
                  "REPLY_RECEIVED"
                ]
              },
              "refId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "interruptId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "parentJobId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              }
            },
            "required": [
              "reason",
              "refId",
              "interruptId",
              "parentJobId"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "resume": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SUMMARY"
          }
        }
      },
      "then": {
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "required": [
              "summaryRef"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input": {
            "properties": {
              "purpose": {
                "const": "FOLLOWUP"
              }
            },
            "required": [
              "purpose"
            ]
          }
        },
        "required": [
          "input"
        ]
      },
      "then": {
        "properties": {
          "input": {
            "required": [
              "followup"
            ]
          }
        }
      }
    }
  ]
}
