{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "jobId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "incidentId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "threadId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "kind": {
      "type": "string",
      "enum": [
        "BASIC",
        "DEEP",
        "RESUME",
        "REPORT",
        "SUMMARY"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "contextRef": {
      "type": "string"
    },
    "resume": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "APPROVAL_DECIDED",
                "REPLY_RECEIVED"
              ]
            },
            "refId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "interruptId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "parentJobId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            }
          },
          "required": [
            "reason",
            "refId",
            "interruptId",
            "parentJobId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "input": {
      "type": "object",
      "description": "선택. 작업 종류별 입력 — 이 계약에 정의한 필드만 싣는다(DB의 job.input을 통째로 내보내지 않는다, 내부 제어값 · 비밀값 없음). SUMMARY는 summaryRef 필수, REPORT는 이전 판을 바탕으로 다시 만들 때 report",
      "properties": {
        "report": {
          "type": "object",
          "description": "REPORT 작업 — 이전 판을 바탕으로 다시 만들 때. lockedSections는 사람이 고친 칸(보고서 칸별 editedBy). Agent는 그 칸에 「[사람이 고친 칸 — 이전 판 유지]」를 넣어 보내고 backend가 baseReportVersion의 원문으로 옮긴다",
          "properties": {
            "baseReportVersion": {
              "type": "integer",
              "minimum": 1
            },
            "lockedSections": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "overview",
                  "investigation",
                  "requestsAndReplies",
                  "actionsAndVerification",
                  "unresolved"
                ]
              }
            }
          },
          "required": [
            "baseReportVersion"
          ],
          "additionalProperties": false
        },
        "summaryRef": {
          "type": "object",
          "description": "요약할 확정 보고서 — 서버가 확정 스냅샷에서 만든다(현재 조사 데이터로 대체하지 않는다)",
          "properties": {
            "reportId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "reportVersion": {
              "type": "integer",
              "minimum": 1
            },
            "contentRevision": {
              "type": "integer",
              "minimum": 0
            },
            "snapshotRef": {
              "type": "string",
              "description": "확정 스냅샷 — snapshot://reports/{reportId}/v{version}/r{contentRevision}"
            }
          },
          "required": [
            "reportId",
            "reportVersion",
            "contentRevision",
            "snapshotRef"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "jobId",
    "incidentId",
    "threadId",
    "kind",
    "attempt",
    "contextRef",
    "resume",
    "createdAt",
    "traceId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RESUME"
          }
        }
      },
      "then": {
        "properties": {
          "resume": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "APPROVAL_DECIDED",
                  "REPLY_RECEIVED"
                ]
              },
              "refId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "interruptId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "parentJobId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              }
            },
            "required": [
              "reason",
              "refId",
              "interruptId",
              "parentJobId"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "resume": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "SUMMARY"
          }
        }
      },
      "then": {
        "required": [
          "input"
        ],
        "properties": {
          "input": {
            "required": [
              "summaryRef"
            ]
          }
        }
      }
    }
  ]
}
