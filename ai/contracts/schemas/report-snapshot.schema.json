{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fab-sop.local/contracts/report-snapshot.schema.json",
  "title": "ReportSnapshot",
  "description": "확정 보고서 스냅샷 — GET /internal/reports/{id}/snapshot. 확정 때 한 번 저장하고 다시 만들지 않는다(확정본이 아니면 404). SUMMARY 작업이 이것만 읽어 1~2줄 요약을 만든다",
  "type": "object",
  "properties": {
    "reportId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "reportVersion": {
      "type": "integer",
      "minimum": 1
    },
    "contentRevision": {
      "type": "integer",
      "minimum": 0
    },
    "snapshotRef": {
      "type": "string",
      "description": "확정 스냅샷 참조 — SUMMARY 작업 input.summaryRef.snapshotRef와 같아야 한다"
    },
    "title": {
      "type": "string"
    },
    "incidentDisplayId": {
      "type": "string",
      "description": "사건 표시 ID(EV-1009 등)"
    },
    "sections": {
      "type": "object",
      "description": "보고서 다섯 칸 — 값은 칸의 글(확정 시점 원문)",
      "properties": {
        "overview": {
          "type": "string"
        },
        "investigation": {
          "type": "string"
        },
        "requestsAndReplies": {
          "type": "string"
        },
        "actionsAndVerification": {
          "type": "string"
        },
        "unresolved": {
          "type": "string"
        }
      },
      "required": [
        "overview",
        "investigation",
        "requestsAndReplies",
        "actionsAndVerification",
        "unresolved"
      ],
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "description": "확정할 때 사람이 고른 원인 분류(4M · 보류). MACHINE이면 그 공정의 장비 파라미터 1개 이상",
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "MATERIAL",
            "MAN",
            "METHOD",
            "MACHINE",
            "HOLD"
          ]
        },
        "equipmentParameters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "category",
        "equipmentParameters"
      ],
      "additionalProperties": false
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confirmedBy": {
      "type": "string"
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "reportId",
    "reportVersion",
    "contentRevision",
    "snapshotRef",
    "incidentDisplayId",
    "sections",
    "classification",
    "evidenceIds",
    "confirmedBy",
    "confirmedAt"
  ],
  "additionalProperties": false
}
