     "422": {
      "description": "파라미터·범위 오류",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/MonitoringError"
        }
       }
      }
     }
    },
    "x-implementation-status": "IMPLEMENTED"
   }
