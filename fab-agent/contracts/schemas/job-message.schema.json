{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "eventId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "jobId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "incidentId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "threadId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    },
    "kind": {
      "type": "string",
      "enum": [
        "BASIC",
        "DEEP",
        "RESUME",
        "REPORT"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "contextRef": {
      "type": "string"
    },
    "resume": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "APPROVAL_DECIDED",
                "REPLY_RECEIVED"
              ]
            },
            "refId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "interruptId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            },
            "parentJobId": {
              "type": "string",
              "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
            }
          },
          "required": [
            "reason",
            "refId",
            "interruptId",
            "parentJobId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "traceId": {
      "type": "string",
      "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "jobId",
    "incidentId",
    "threadId",
    "kind",
    "attempt",
    "contextRef",
    "resume",
    "createdAt",
    "traceId"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "RESUME"
          }
        }
      },
      "then": {
        "properties": {
          "resume": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "enum": [
                  "APPROVAL_DECIDED",
                  "REPLY_RECEIVED"
                ]
              },
              "refId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "interruptId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              },
              "parentJobId": {
                "type": "string",
                "description": "불투명 식별자. 화면에는 EV-1024 같은 표시 ID 사용"
              }
            },
            "required": [
              "reason",
              "refId",
              "interruptId",
              "parentJobId"
            ],
            "additionalProperties": false
          }
        }
      },
      "else": {
        "properties": {
          "resume": {
            "type": "null"
          }
        }
      }
    }
  ]
}
