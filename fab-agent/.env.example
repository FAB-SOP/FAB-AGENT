# 복사해서 .env로 쓴다:  cp .env.example .env
# .env는 git에 올리지 않는다(.gitignore에 있음).

# --- 모델 ---
FAB_LLM=openai                 # openai | rule (rule = 키 없이 도는 규칙 모델)
OPENAI_API_KEY=
FAB_MODEL=gpt-4.1-mini
FAB_FALLBACK_MODEL=gpt-4o-mini

# --- 임베딩 (지식 MCP) ---
# openai = 의미 검색(compose · 시연 기본, OPENAI_API_KEY 필요 — 없거나 틀리면 지식 MCP가 시작에 실패한다)
# hash   = 키 없이 도는 시험용 글자 n-gram 해시(pytest · 키 없는 점검)
EMBEDDER=openai
EMBED_MODEL=text-embedding-3-small   # 1536차원 → knowledge.chunks_d1536

# --- 관측 (선택) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fab-agent
FAB_TRACE_FILE=
