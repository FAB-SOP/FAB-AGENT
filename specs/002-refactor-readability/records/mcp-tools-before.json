    "name": "search_technical_documents",
    "title": "Search Technical Documents",
    "description": "실제 출판 문서 7편(MIT/TI CMP · 플라스마 센싱 논문 · MKS 유량/CVD · UCSB ICP 매뉴얼 · NIST 계측 · NIST/SEMATECH\n통계 핸드북)의 원문 조각을 찾는다. '왜 그 원인을 의심하는지'의 일반 원리를 인용할 때 쓴다.\n결과마다 원문 쪽 · 출처 · 적용 한계(applicabilityLimits)가 붙는다 — 답변에 적용 한계를 함께 밝힌다.\nfiguresEquationsTablesRequireSourceCheck=true면 수식 · 표 숫자는 원문 확인이 필요하다.\n원문은 영어다 — 질의에 영어 용어 · 약어를 함께 쓰면 잘 찾는다(예: 질량유량제어기(MFC) calibration 오차).",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "query": {
       "description": "찾고 싶은 내용",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "process": {
       "anyOf": [
        {
         "enum": [
          "CVD",
          "ETCH",
          "CMP"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "공정으로 좁힌다"
      },
      "retrievalTier": {
       "anyOf": [
        {
         "enum": [
          "PROCESS_PRINCIPLE",
          "SENSOR_INTERPRETATION",
          "METROLOGY_INTERPRETATION",
          "STATISTICAL_INTERPRETATION",
          "EQUIPMENT_REFERENCE_NOT_ACTION_SOP"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "원리 · 센서 해석 · 계측 해석 · 통계(관리도) 해석 · 장비 참고"
      },
      "documentId": {
       "anyOf": [
        {
         "enum": [
          "DOC01",
          "DOC02",
          "DOC03",
          "DOC04",
          "DOC05",
          "DOC06",
          "DOC07"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "문서 하나로 좁힌다"
      },
      "version": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "원문 묶음 판(예: 2026-10-20). 비우면 지금 색인된 판"
      },
      "topK": {
       "default": 3,
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "query"
     ]
    },
    "output_schema": {
     "additionalProperties": true,
     "type": "object"
    },
    "annotations": {
     "read_only_hint": true,
     "destructive_hint": false,
     "idempotent_hint": true,
     "open_world_hint": false
    },
    "meta": {
     "fastmcp": {
      "tags": []
     }
    }
