   {
    "name": "get_run_and_metrology",
    "title": "Get Run And Metrology",
    "description": "run 하나의 공정 결과를 돌려준다 — 5위치 두께와 평균, 입고 · 출고 두께, 증착량/제거량, 처리 시간,\n동결 관리한계(I 관리도, R1) 판정과 제품 규격, 같은 PM · 전체 PM 정상 run 대비 편차(z).\n계산은 backend가 한다. 분석 시점 이후 공개된 계측은 available=false로 온다.",
    "input_schema": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "runId": {
       "description": "run ID. 예: RUN-W-CURRENT-009-3-ETCH — get_wafer_lineage로 얻는다",
       "type": "string"
      }
     },
     "required": [
      "runId"
     ]
    },
    "output_schema": {
     "additionalProperties": true,
     "type": "object"
    },
    "annotations": {
     "read_only_hint": true,
     "destructive_hint": false,
     "idempotent_hint": true,
     "open_world_hint": false
